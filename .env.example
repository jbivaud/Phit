# Copy this file to .env and fill in your Garmin Connect credentials.
# These are read by the backend on startup to auto-connect; never commit the real .env file.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Where to cache Garmin session tokens after the first successful login,
# so you don't have to re-enter your password (or MFA code) every time.
GARMIN_TOKEN_STORE=~/.phit/garmin_tokens
